{
  "realm": "kanban",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "kanban-frontend",
      "name": "Kanban Frontend",
      "description": "Client publico com PKCE S256. Sem secret: segredo em client publico e falso controle. defaultClientScopes inclui basic, que emite a claim sub consumida pelo provisionamento JIT.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["${FRONTEND_PUBLIC_URL}/*"],
      "webOrigins": ["${FRONTEND_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_PUBLIC_URL}/*"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "admin-kanban",
      "enabled": true,
      "emailVerified": true,
      "email": "${KANBAN_ADMIN_EMAIL}",
      "firstName": "Admin",
      "lastName": "Kanban",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-kanban",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@kanban.local",
      "firstName": "Dev",
      "lastName": "Kanban",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
