# Copie para `docker/.env` e ajuste. O `.env` real nunca e versionado.
# Nenhum valor secreto entra aqui: credencial vai por arquivo montado
# (`secrets:`), conforme `infra/docker/architecture.md` secao 7.

# ---------------------------------------------------------------- imagens
# Fonte unica da versao do banco. O mesmo valor alimenta o compose e a suite
# de contêineres de teste (`TesteDeIntegracao`), porque "a mesma imagem do
# compose" escrito em prosa nao e verificavel.
POSTGRES_IMAGE=postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4@sha256:9409c59bdfb65dbffa20b11e6f18b8abb9281d480c7ca402f51ed3d5977e6007
MAVEN_IMAGE=maven:3.9-eclipse-temurin-25@sha256:31618505df21177d2baa3dc574be2d0b0b32614c8539baca1f23a9136b766eb0
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.56.0-noble@sha256:35246d87a7c88ea9b771c65d33171b2611b02a8253b4b12ce6f94376c55f99f2
PROXY_IMAGE=nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

# --------------------------------------------------- proveniencia da imagem
# Revisao de codigo que originou a imagem construida (ADR-013). Nao ha
# registry: a marca e local e serve para dizer de onde a imagem veio.
# Preencha com `git rev-parse --short HEAD`.
REVISAO=dev

# ------------------------------------------------------------- configuracao
# Configuracao nao sensivel entra por variavel; credencial, nao.
BANCO_NOME=kanban
BANCO_USUARIO=kanban

# O `iss` do token e o que o browser ve, entao o issuer e o endereco publicado
# no host. A chave de assinatura, essa, e buscada pela rede interna — ver o
# comentario do servico `backend` no compose.
IDENTIDADE_REALM=idsd
IDENTIDADE_HOSTNAME=http://localhost:8180

# Porta publicada de cada servico que uma pessoa acessa do navegador, mais a do
# banco, que sai publicada so em desenvolvimento e so para inspecao manual.
# Toda porta e parametrizavel porque o padrao ja colidiu na pratica: outra stack
# da mesma maquina ocupava 5432, 8080 e 8180, e o Compose falha no bind sem
# dizer de quem e a porta. Trocar aqui resolve sem tocar no compose.
PORTA_FRONTEND=3000
PORTA_BACKEND=8080
PORTA_IDENTIDADE=8180
PORTA_BANCO=5432

# ------------------------------------------------------------------ segredo
# Caminho do arquivo de credencial. Em desenvolvimento aponta para o valor
# descartavel versionado; em qualquer outro ambiente aponta para fora do
# repositorio. O mecanismo e o mesmo nos dois — caminho de producao que nao e
# exercitado em desenvolvimento nao e caminho testado.
BANCO_SENHA_FILE=./secrets/banco-senha.dev

# `subject_id` da conta promovida a administradora global (ADR-010). Fixado no
# realm de desenvolvimento para nao virar valor magico depois. Consumido pela
# TASK-01.4, que e quem implementa o bootstrap.
# IDENTIDADE_ADMIN_SUBJECT=6f9d4c2a-0000-4000-8000-000000000005
