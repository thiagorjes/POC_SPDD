{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": {
    "entry": [
      "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
      "src/proxy.ts"
    ]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["e2e/**/*.spec.ts", "e2e/suporte/*.ts", "e2e/verificacoes/*.spec.ts"]
  },
  "jest": {
    "config": ["jest.config.ts"],
    "entry": ["jest.setup.ts", "src/**/*.test.{ts,tsx}"]
  },
  "ignoreUnresolved": ["../CartaoDeTarefa", "../TempoPorEtapa"]
}
