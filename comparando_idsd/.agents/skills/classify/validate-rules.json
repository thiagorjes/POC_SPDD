{
  "skill": "classify",
  "artifact_pattern": "docs/intent/*-classification.md",
  "modes": {
    "input": {
      "stale_check": "mtime",
      "required_artifacts": [
        "docs/intent/{{FEATURE}}-intent.md"
      ]
    },
    "output": {
      "required_sections": [
        "## Classificação",
        "## Flow resolvido",
        "## Override",
        "## Reclassificação",
        "## Fora deste artefato — regras negativas"
      ],
      "no_empty_placeholders": true,
      "gherkin_required_for_ids": [],
      "forbidden_patterns": [
        {
          "pattern": "\\b(RF|RNF|RN)-\\d+",
          "motivo": "requisito numerado",
          "pertence_a": "/prd"
        },
        {
          "pattern": "\\b(story points?|homem[- ]hora|\\d+\\s*(h|horas|dias)\\s+de\\s+esforço)\\b",
          "motivo": "estimativa de esforço",
          "pertence_a": "/tasks"
        },
        {
          "pattern": "\\bTASK-\\d+",
          "motivo": "task de implementação",
          "pertence_a": "/tasks"
        }
      ],
      "custom_steps": [
        {
          "name": "check_classificacao",
          "script": ".agents/skills/classify/scripts/check_classificacao.py",
          "args": ["--artifact", "{{INPUT_ARTIFACT}}"]
        }
      ]
    }
  }
}
