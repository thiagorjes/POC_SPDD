{
  "skill": "guidelines",
  "artifact_pattern": "guidelines.yaml",
  "modes": {
    "input": {
      "required_artifacts": [
        "memory/constitution.md"
      ]
    },
    "output": {
      "no_empty_placeholders": true,
      "forbidden_patterns": [
        {
          "pattern": "^\\s*(RF|RNF|RN)-\\d{3}\\s*[—:-]\\s*\\w",
          "motivo": "requisito de produto",
          "pertence_a": "/prd"
        },
        {
          "pattern": "```gherkin",
          "motivo": "cenário Gherkin",
          "pertence_a": "/prd"
        },
        {
          "pattern": "\\bTASK-\\d{2}\\.\\d{1,2}\\b",
          "motivo": "planejamento de task",
          "pertence_a": "/tasks"
        }
      ],
      "custom_steps": [
        {
          "name": "check_guidelines",
          "script": ".agents/skills/guidelines/scripts/check_guidelines.py",
          "args": ["--sistema", "{{ROOT}}"]
        }
      ]
    }
  }
}
