{
  "skill": "intent",
  "artifact_pattern": "docs/intent/*-intent.md",
  "modes": {
    "input": {
      "required_artifacts": []
    },
    "output": {
      "required_sections": [
        "## Resultado esperado",
        "## Motivação",
        "## Limites declarados",
        "## Fora de escopo",
        "## Interface",
        "## Fora deste artefato — regras negativas"
      ],
      "no_empty_placeholders": true,
      "gherkin_required_for_ids": [],
      "forbidden_patterns": [
        {
          "pattern": "\\b(RF|RNF|RN)-\\d+",
          "motivo": "requisito numerado",
          "pertence_a": "/prd"
        },
        {
          "pattern": "^\\s*(Dado|Given)\\s+que\\b",
          "motivo": "cenário Gherkin",
          "pertence_a": "/prd"
        },
        {
          "pattern": "\\b(PostgreSQL|MySQL|Redis|Kafka|React|Angular|Vue|Docker|Kubernetes|GraphQL)\\b",
          "motivo": "escolha de tecnologia",
          "pertence_a": "/techspec"
        },
        {
          "pattern": "\\bTASK-\\d+",
          "motivo": "task de implementação",
          "pertence_a": "/tasks"
        }
      ],
      "custom_steps": [
        {
          "name": "check_validacao_demandante",
          "script": ".agents/skills/intent/scripts/check_validacao.py",
          "args": ["--artifact", "{{INPUT_ARTIFACT}}"]
        }
      ]
    }
  }
}
