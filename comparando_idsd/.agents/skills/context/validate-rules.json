{
  "skill": "context",
  "artifact_pattern": "docs/context/*-context.md",
  "modes": {
    "input": {
      "stale_check": "mtime",
      "required_artifacts": [
        "docs/intent/{{FEATURE}}-classification.md"
      ]
    },
    "output": {
      "required_sections": [
        "## Contexto resolvido",
        "## Lacunas",
        "## Suposições operacionais",
        "## Sistemas e artefatos em jogo",
        "## Fora deste artefato — regras negativas"
      ],
      "no_empty_placeholders": true,
      "gherkin_required_for_ids": [],
      "forbidden_patterns": [
        {
          "pattern": "conhecimento do modelo|pr[áa]tica (comum|de mercado)|padr[ãa]o da ind[úu]stria|presumo que|assumo que",
          "motivo": "fonte inválida — isto é lacuna, não contexto resolvido",
          "pertence_a": "a seção Lacunas"
        },
        {
          "pattern": "\\b(RF|RNF|RN)-\\d+\\s*[—:-]\\s*\\S",
          "motivo": "definição de requisito",
          "pertence_a": "/prd"
        },
        {
          "pattern": "^\\s*(Decidimos|Decisão:|Optamos por)\\b",
          "motivo": "decisão",
          "pertence_a": "/shape, /prd ou /techspec"
        }
      ],
      "custom_steps": [
        {
          "name": "check_lacunas",
          "script": ".agents/skills/context/scripts/check_lacunas.py",
          "args": ["--artifact", "{{INPUT_ARTIFACT}}"]
        }
      ]
    }
  }
}
