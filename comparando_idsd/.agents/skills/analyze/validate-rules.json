{
  "skill": "analyze",
  "artifact_pattern": "docs/analyze/*-analysis.md",
  "modes": {
    "input": {
      "stale_check": "mtime",
      "required_artifacts": [
        "docs/prd/{{FEATURE}}-prd.md",
        "docs/techspec/{{FEATURE}}-techspec.md"
      ]
    },
    "output": {
      "required_sections": [
        "## Artefatos e versões",
        "## Cobertura da cadeia",
        "## Achados",
        "## Procedência e hipóteses",
        "## Veredicto",
        "## Fora deste artefato — regras negativas"
      ],
      "id_patterns": {
        "INC": "INC-\\d{2}"
      },
      "no_empty_placeholders": true,
      "forbidden_patterns": [
        {
          "pattern": "^\\s*(RF|RNF|RN)-\\d{3}\\s*[—:-]\\s*\\w",
          "motivo": "definição de requisito",
          "pertence_a": "/prd"
        },
        {
          "pattern": "```gherkin",
          "motivo": "cenário Gherkin",
          "pertence_a": "/prd"
        },
        {
          "pattern": "\\b(corrigi|apliquei a correção|atualizei o PRD|ajustei a TechSpec)\\b",
          "motivo": "correção feita pela análise",
          "pertence_a": "o artefato dono do achado"
        },
        {
          "pattern": "\\bTASK-\\d{2}\\.\\d{1,2}\\b",
          "motivo": "planejamento de task",
          "pertence_a": "/tasks"
        }
      ],
      "custom_steps": [
        {
          "name": "check_consistencia",
          "script": ".agents/skills/analyze/scripts/check_consistencia.py",
          "args": ["--artifact", "{{INPUT_ARTIFACT}}"]
        }
      ]
    }
  }
}
