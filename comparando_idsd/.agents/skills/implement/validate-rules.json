{
  "skill": "implement",
  "artifact_pattern": "docs/tasks/*/TASK-*.md",
  "modes": {
    "input": {
      "stale_check": "mtime",
      "required_artifacts": [
        "docs/tasks/{{FEATURE}}-tasks.md",
        "docs/tests/{{FEATURE}}-verificacao.md"
      ]
    },
    "output": {
      "required_sections": [
        "#### Contexto",
        "#### Critérios de aceite",
        "#### Histórico"
      ],
      "id_patterns": {
        "TASK": "TASK-\\d{2}\\.\\d{1,2}",
        "SCN": "SCN-\\d{3}\\.\\d{1,2}"
      },
      "no_empty_placeholders": true,
      "custom_steps": [
        {
          "name": "check_task_files",
          "script": ".agents/skills/tasks/scripts/check_task_files.py",
          "args": ["--task", "{{INPUT_ARTIFACT}}"]
        },
        {
          "name": "check_escopo",
          "script": ".agents/skills/implement/scripts/check_escopo.py",
          "args": ["--task", "{{INPUT_ARTIFACT}}"]
        }
      ]
    }
  }
}
