# Copie para .env antes de subir o compose. Nenhum destes valores entra na imagem (ADR-008).

# Portas publicadas no host. Altere se ja houver algo ocupando estas portas na maquina;
# ao mudar KEYCLOAK_PORT ou BACKEND_PORT, ajuste tambem as URLs publicas abaixo.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
BACKEND_PORT=8081
FRONTEND_PORT=3000

POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=trocar-esta-senha

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=trocar-esta-senha
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# `iss` do token, como o navegador o ve. Precisa bater exatamente com o emissor.
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/kanban
# Chaves publicas, buscadas de dentro da rede do compose.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/kanban/protocol/openid-connect/certs

# Senha dos usuarios de desenvolvimento do realm importado (admin.kanban, ana.dev, bruno.gestor).
KEYCLOAK_SEED_PASSWORD=trocar-esta-senha

KANBAN_ADMIN_EMAIL=admin@crudao.com.br
# Origens do navegador autorizadas a chamar a API. Lista separada por virgula, nunca `*`.
KANBAN_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=http://localhost:8081/ws
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=kanban
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=kanban-frontend
