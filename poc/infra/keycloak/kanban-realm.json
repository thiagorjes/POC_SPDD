{
  "realm": "kanban",
  "enabled": true,
  "displayName": "Kanban de Tarefas Configuravel",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "kanban-frontend",
      "name": "Kanban Frontend",
      "description": "Escopos padrao incluem `basic` (claim sub), `profile` (name) e `email` (email) — as tres claims lidas pelo UsuarioProvisioningService. Remover `basic` faz o sub sumir do access token e quebra o provisionamento JIT.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "${FRONTEND_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": ["${FRONTEND_PUBLIC_URL}/*"],
      "webOrigins": ["${FRONTEND_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_PUBLIC_URL}/*"
      },
      "defaultClientScopes": ["basic", "acr", "profile", "email", "roles", "web-origins"]
    }
  ],
  "users": [
    {
      "username": "admin.kanban",
      "email": "admin@crudao.com.br",
      "firstName": "Admin",
      "lastName": "Global",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "ana.dev",
      "email": "ana.dev@crudao.com.br",
      "firstName": "Ana",
      "lastName": "Desenvolvedora",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bruno.gestor",
      "email": "bruno.gestor@crudao.com.br",
      "firstName": "Bruno",
      "lastName": "Gestor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
